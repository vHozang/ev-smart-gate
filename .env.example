# Simulator giúp chạy toàn bộ workflow mà không cần tải model lớn.
ALPR_PROVIDER=simulated
FACE_PROVIDER=simulated
CARGO_PROVIDER=simulated
SIMULATOR_PLATE_NUMBER=30A12345
REQUIRE_LIVENESS=true
FACE_SIMILARITY_THRESHOLD=0.75

BARRIER_MODE=http
BARRIER_HTTP_URL=http://barrier-simulator:8080/commands
BARRIER_TIMEOUT_SECONDS=3

EDGE_API_URL=http://api:8000
EDGE_WORKFLOW=entry
EDGE_GATE_ID=gate-in-01
EDGE_INTERVAL_SECONDS=10

# Automated MVP demo. Keep OPENAI_API_KEY empty in version control and set it in .env.
DEMO_BASE_URL=http://localhost:8000
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
DEMO_LANGUAGE=vi
DEMO_BURN_SUBTITLES=true
DEMO_INTRO_MS=1200
DEMO_OUTRO_MS=1800
