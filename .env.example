# Chỉ dùng cho môi trường local/simulator; không tái sử dụng secret này ở production.
APP_ENV=local
APP_NAME=EV Smart Gate
APP_PUBLIC_ORIGIN=http://localhost:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

MONGODB_URI=mongodb://mongodb:27017/?replicaSet=rs0
MONGODB_DATABASE=ev_smart_gate

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=smartgate-local
MINIO_SECRET_KEY=smartgate-local-secret
MINIO_BUCKET=smart-gate-evidence
MINIO_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Local-SmartGate-Admin-2026
SESSION_SECRET=local-session-signing-secret-2026-rotate
SESSION_TTL_SECONDS=28800
DEVICE_API_KEY=local-edge-device-key-2026
EDGE_DEVICE_KEY=local-edge-device-key-2026

OPERATOR_AUTH_ENABLED=true
AUTH_LEGACY_ENABLED=true
AUTH_ISSUER=http://localhost:8000
AUTH_AUDIENCE=ev-smart-gate-console
AUTH_KEY_ID=operator-ed25519-v1
AUTH_KID=operator-ed25519-v1
AUTH_PRIVATE_KEY=TM0Imyj_ltqdtsNG7BFOD1uKMZ81q6Yk2oz27U-4pvs=
