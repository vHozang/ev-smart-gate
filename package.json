{
  "name": "ev-smart-gate-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright-driven narrated MVP demo workflow for EV Smart Gate",
  "scripts": {
    "test": "node --test tests/demo-scripts/*.test.mjs",
    "demo:test": "node scripts/demo/run-playwright.mjs",
    "demo:voice": "node scripts/demo/generate-voice.mjs",
    "demo:srt": "node scripts/demo/generate-srt.mjs",
    "demo:build": "node scripts/demo/build-demo.mjs",
    "demo:verify": "node scripts/demo/verify-demo.mjs dist/demo/MVP-Demo.mp4",
    "demo:mvp": "node scripts/demo/run-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "node-edge-tts": "^1.2.10"
  }
}
