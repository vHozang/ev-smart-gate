FROM golang:1.24.8-bookworm AS builder

# Release chính chủ, xác minh dependency qua Go checksum database mặc định.
ENV CGO_ENABLED=0 GOBIN=/out GOTOOLCHAIN=local
RUN go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home miniotest \
    && mkdir /data && chown miniotest:miniotest /data
COPY --from=builder /out/minio /usr/local/bin/minio
USER miniotest
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
